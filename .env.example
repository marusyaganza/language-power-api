# Local development settings. Copy to .env: cp .env.example .env
# Every value here works with docker-compose.yml and mock mode, without API keys.
# The README's "Environment variables" section describes each setting.

# Dictionary. true serves recorded responses from dictionary/fixtures and needs
# no keys; false calls the real Merriam-Webster API with your own keys.
USE_MOCKS=true
# ENGLISH_API_KEY=
# SPANISH_API_KEY=

# Optional. The values shown are the defaults.
# DATABASE_URL=postgresql+psycopg://app_user:dev_password@localhost:5432/language_app
# REDIS_URL=redis://localhost:6379/0
# SIGNUP_ENABLED=true
# COOKIE_SECURE=false
# SESSION_TTL_SECONDS=2592000
# DOCS_ENABLED=true
# CORS_ORIGINS=["http://localhost:5173"]
