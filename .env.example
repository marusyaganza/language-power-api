# Local development settings. Copy to .env: cp .env.example .env
# Every value here works with docker-compose.yml and mock mode, without API keys.
# docs/configuration.md describes every setting.

# Dictionary. true serves made-up entries from dictionary/fixtures and needs
# no keys; false calls the real Merriam-Webster API with your own keys.
USE_MOCKS=true
# ENGLISH_API_KEY=
# SPANISH_API_KEY=

# Optional. The values shown are the defaults.
# DATABASE_URL=postgresql+psycopg://app_user:dev_password@localhost:5432/language_app
# REDIS_URL=redis://localhost:6379/0
# SIGNUP_ENABLED=true
# COOKIE_SECURE=false
# SESSION_TTL_SECONDS=2592000
# DOCS_ENABLED=true
# /api when the frontend runs through the Vite dev proxy, so the mock words'
# audio and pictures (/sample-media) load through it too.
# ROOT_PATH=
# CORS_ORIGINS=["http://localhost:5173"]
