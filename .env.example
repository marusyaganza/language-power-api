# Local development settings. Copy to .env: cp .env.example .env
# Every value here works with docker-compose.yml and mock mode, without API keys.
# The README's "Environment variables" section describes each setting.

# Dictionary. "True" (exactly) serves recorded responses from dictionary/fixtures;
# anything else calls the real Merriam-Webster API with the keys below.
USE_MOCKS=True
ENGLISH_API_KEY=not-needed-with-mocks
SPANISH_API_KEY=not-needed-with-mocks
ENGLISH_API_URL=https://dictionaryapi.com/api/v3/references/collegiate/json
SPANISH_API_URL=https://www.dictionaryapi.com/api/v3/references/spanish/json
AUDIO_ENDPOINT=https://media.merriam-webster.com/audio/prons
IMG_ENDPOINT=https://merriam-webster.com/assets/mw/static/art/dict

# Optional. The values shown are the defaults.
# DATABASE_URL=postgresql+psycopg://app_user:dev_password@localhost:5432/language_app
# REDIS_URL=redis://localhost:6379/0
# SIGNUP_ENABLED=true
# COOKIE_SECURE=false
# SESSION_TTL_SECONDS=2592000
# DOCS_ENABLED=true
# CORS_ORIGINS=["http://localhost:5173"]
