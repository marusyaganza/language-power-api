[run]
source = .
# SQLAlchemy's async layer runs DB code in greenlets; without this,
# lines after an `await` on the database are reported as missed.
concurrency = greenlet, thread
omit =
    tests/*
    venv/*
    .venv/*
    alembic/*
    games/seed.py

[report]
show_missing = true
skip_empty = true
